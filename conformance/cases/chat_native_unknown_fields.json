{
 "name": "chat_native_unknown_fields",
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.local]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"local-secret\"\n\n[[models]]\nname = \"llama3.1\"\nprovider = \"local\"\nmodel = \"llama3.1\"\n",
 "upstream": {
  "raw_body": {
   "id": "chatcmpl-9",
   "object": "chat.completion",
   "created": 1,
   "model": "llama3.1",
   "choices": [
    {
     "index": 0,
     "message": {
      "role": "assistant",
      "content": "ok"
     },
     "finish_reason": "stop"
    }
   ],
   "usage": {
    "prompt_tokens": 2,
    "completion_tokens": 1,
    "total_tokens": 3
   }
  }
 },
 "request": {
  "method": "POST",
  "path": "/v1/chat/completions",
  "body": {
   "model": "llama3.1",
   "messages": [
    {
     "role": "user",
     "content": "Hi"
    }
   ],
   "mystery_field": {
    "nested": [
     1,
     2,
     3
    ]
   },
   "future_flag": true
  }
 },
 "expect": {
  "status": 200,
  "upstream": {
   "path": "/v1/chat/completions",
   "headers": {
    "authorization": "Bearer local-secret"
   },
   "json_equal_request": true
  },
  "client_body": {
   "paths": {
    "choices.0.message.content": "ok"
   }
  }
 }
}
