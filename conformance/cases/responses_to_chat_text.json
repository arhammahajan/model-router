{
 "name": "responses_to_chat_text",
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
 "upstream": {
  "raw_body": {
   "id": "chatcmpl-up",
   "object": "chat.completion",
   "created": 1,
   "model": "gpt-4o-mini",
   "choices": [
    {
     "index": 0,
     "message": {
      "role": "assistant",
      "content": "hello"
     },
     "finish_reason": "stop"
    }
   ],
   "usage": {
    "prompt_tokens": 7,
    "completion_tokens": 3,
    "total_tokens": 10
   }
  }
 },
 "request": {
  "method": "POST",
  "path": "/v1/responses",
  "body": {
   "model": "bridge-resp",
   "input": "Hi",
   "instructions": "Be brief.",
   "max_output_tokens": 16,
   "temperature": 0.5,
   "top_p": 0.9
  }
 },
 "expect": {
  "status": 200,
  "upstream": {
   "path": "/chat/completions",
   "exact_requests": 1,
   "headers": {
    "authorization": "Bearer upstream-secret"
   },
   "body": {
    "paths": {
     "model": "gpt-4o-mini",
     "messages.0.role": "system",
     "messages.0.content": "Be brief.",
     "messages.1.role": "user",
     "messages.1.content": "Hi",
     "max_tokens": 16,
     "temperature": 0.5,
     "top_p": 0.9
    }
   }
  },
  "client_body": {
   "paths": {
    "status": "completed",
    "output.0.type": "message",
    "output.0.status": "completed",
    "output.0.content.0.type": "output_text",
    "output.0.content.0.text": "hello",
    "usage.input_tokens": 7,
    "usage.output_tokens": 3,
    "usage.total_tokens": 10
   }
  }
 }
}
