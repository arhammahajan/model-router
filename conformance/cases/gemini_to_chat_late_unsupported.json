{
  "name": "gemini_to_chat_late_unsupported",
  "_comment": "POLICY: a model-generated invalid tool call is honestly reported as native finishReason MALFORMED_FUNCTION_CALL (HTTP 200), not ordinary STOP and not a fabricated success. Per the official OpenAI Chat docs, function arguments may be invalid JSON; the Python baseline maps this same condition to Gemini 200+MALFORMED. Parser/envelope/bound violations still fail with 502 and no terminal; MALFORMED never hides oversize input.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"gem-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-up",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "",
            "tool_calls": [
              {
                "id": "call_up_1",
                "type": "function",
                "function": {
                  "name": "get_time",
                  "arguments": "not-json{{{"
                }
              }
            ]
          },
          "finish_reason": "tool_calls"
        }
      ],
      "usage": {
        "prompt_tokens": 7,
        "completion_tokens": 3,
        "total_tokens": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-chat:generateContent",
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ],
      "tools": [
        {
          "functionDeclarations": [
            {
              "name": "get_time",
              "parametersJsonSchema": {
                "type": "object"
              }
            }
          ]
        }
      ],
      "generationConfig": {
        "candidateCount": 1
      }
    }
  },
  "expect": {
    "status": 200,
    "client_text_contains": [
      "\"finishReason\":\"MALFORMED_FUNCTION_CALL\""
    ],
    "client_text_absent": [
      "Traceback",
      "\"finishReason\":\"STOP\"",
      "\"functionCall\""
    ],
    "client_body": {
      "paths": {
        "candidates.0.finishReason": "MALFORMED_FUNCTION_CALL",
        "modelVersion": "gem-chat",
        "responseId": "chatcmpl-up",
        "usageMetadata.promptTokenCount": 7,
        "usageMetadata.candidatesTokenCount": 3,
        "usageMetadata.totalTokenCount": 10
      },
      "absent": [
        "candidates.0.content.parts.0.functionCall"
      ]
    },
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 1
    }
  }
}
