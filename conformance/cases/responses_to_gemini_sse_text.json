{
  "_comment": "Responses->Gemini contract. Client streams Responses SSE; upstream streams Gemini SSE (?alt=sse). Terminal output repeats prior deltas with stable id and 0-based sequence.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "expect": {
    "client_text_absent": [
      "response.failed"
    ],
    "client_text_contains": [
      "\"delta\":\"hel\"",
      "\"delta\":\"lo\"",
      "\"text\":\"hello\"",
      "\"sequence_number\":9"
    ],
    "sse": {
      "absent": [
        "[DONE]"
      ],
      "events": [
        "response.created",
        "response.in_progress",
        "response.output_item.added",
        "response.content_part.added",
        "response.output_text.delta",
        "response.output_text.delta",
        "response.output_text.done",
        "response.content_part.done",
        "response.output_item.done",
        "response.completed"
      ],
      "integrity": "responses",
      "sequence_numbers": true
    },
    "status": 200,
    "upstream": {
      "body": {
        "absent": [
          "model",
          "stream"
        ],
        "paths": {
          "contents.0.parts.0.text": "Hi"
        }
      },
      "exact_requests": 1,
      "path": "/v1beta/models/gemini-2.0-flash:streamGenerateContent",
      "query": "alt=sse"
    }
  },
  "name": "responses_to_gemini_sse_text",
  "request": {
    "body": {
      "input": "Hi",
      "model": "bridge-gem",
      "stream": true
    },
    "method": "POST",
    "path": "/v1/responses"
  },
  "upstream": {
    "sse_frames": [
      "data: {\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"hel\"}],\"role\":\"model\"},\"index\":0}]}\n\n",
      "data: {\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"lo\"}],\"role\":\"model\"},\"finishReason\":\"STOP\",\"index\":0}],\"usageMetadata\":{\"promptTokenCount\":7,\"candidatesTokenCount\":3,\"totalTokenCount\":10}}\n\n"
    ],
    "status": 200
  }
}
