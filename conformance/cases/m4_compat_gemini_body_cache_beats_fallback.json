{
  "_comment": "F7 compat configured prompt_cache_key body beats Gemini fallback. RED via --validate-config.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\nbearer_session_compat = true\n\n[retry]\nmax_attempts = 1\n\n[providers.sess]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\nsession_header = \"x-affinity\"\nsession_prompt_cache_key = true\n\n[[models]]\nname = \"gem-chat\"\nprovider = \"sess\"\nmodel = \"gpt-4o-mini\"\n",
  "expect": {
    "status": 200,
    "client_body": {
      "paths": {
        "candidates.0.content.parts.0.text": "hello",
        "candidates.0.finishReason": "STOP",
