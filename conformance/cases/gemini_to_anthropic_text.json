{
  "name": "gemini_to_anthropic_text",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"gem-ant\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n",
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-ant:generateContent",
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ],
      "systemInstruction": {
        "parts": [
          {
            "text": "Be brief."
          }
        ]
      },
      "generationConfig": {
        "candidateCount": 1,
        "maxOutputTokens": 16,
        "temperature": 0.5,
        "topP": 0.9
      }
    }
  },
  "upstream": {
    "raw_body": {
      "id": "msg_up",
      "type": "message",
      "role": "assistant",
      "model": "claude-haiku-4-5",
      "content": [
        {
          "type": "text",
          "text": "hello"
        }
      ],
      "stop_reason": "end_turn",
      "usage": {
        "input_tokens": 7,
        "output_tokens": 3
      }
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/v1/messages",
      "exact_requests": 1,
      "headers": {
        "x-api-key": "upstream-secret",
        "authorization": {
          "absent": true
        },
        "anthropic-version": "2023-06-01"
      },
      "query": "",
      "query_absent": [
        "key",
        "alt"
      ],
      "body": {
        "paths": {
          "model": "claude-haiku-4-5",
          "max_tokens": 16,
          "messages.0.role": "user",
          "messages.0.content.0.text": "Hi",
          "system.0.text": "Be brief.",
          "temperature": 0.5,
          "top_p": 0.9
        }
      }
    },
    "client_body": {
      "paths": {
        "candidates.0.content.parts.0.text": "hello",
        "candidates.0.finishReason": "STOP",
        "modelVersion": "gem-ant",
        "responseId": "msg_up",
        "usageMetadata.promptTokenCount": 7,
        "usageMetadata.candidatesTokenCount": 3,
        "usageMetadata.totalTokenCount": 10
      }
    }
  }
}
