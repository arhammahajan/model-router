{
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"claude-haiku\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n",
 "expect": {
  "client_headers": {
   "Retry-After": "2"
  },
  "client_text_absent": [
   "sk-secret",
   "prompt hello"
  ],
  "status": 429,
  "upstream": {
   "exact_requests": 1,
   "path": "/v1/messages"
  }
 },
 "name": "chat_translated_error_sanitized",
 "request": {
  "body": {
   "messages": [
    {
     "content": "Hi",
     "role": "user"
    }
   ],
   "model": "claude-haiku"
  },
  "method": "POST",
  "path": "/v1/chat/completions"
 },
 "upstream": {
  "headers": {
   "Content-Type": "application/json",
   "Retry-After": "2"
  },
  "raw_body": {
   "error": {
    "message": "sk-secret prompt hello",
    "type": "rate_limit_error"
   },
   "type": "error"
  },
  "status": 429
 }
}