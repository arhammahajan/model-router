{
 "name": "chat_to_anthropic_text",
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"claude-haiku\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n",
 "upstream": {
  "raw_body": {
   "id": "msg_1",
   "type": "message",
   "role": "assistant",
   "model": "m",
   "content": [
    {
     "type": "text",
     "text": "hello"
    }
   ],
   "stop_reason": "end_turn",
   "usage": {
    "input_tokens": 7,
    "output_tokens": 3
   }
  }
 },
 "request": {
  "method": "POST",
  "path": "/v1/chat/completions",
  "body": {
   "model": "claude-haiku",
   "messages": [
    {
     "role": "system",
     "content": "Be brief."
    },
    {
     "role": "user",
     "content": "Hi"
    }
   ],
   "max_tokens": 16
  }
 },
 "expect": {
  "status": 200,
  "upstream": {
   "path": "/v1/messages",
   "headers": {
    "x-api-key": "upstream-secret",
    "authorization": {
     "absent": true
    },
    "anthropic-version": "2023-06-01"
   },
   "body": {
    "paths": {
     "model": "claude-haiku-4-5",
     "max_tokens": 16,
     "messages.0.role": "user",
     "system.0.text": "Be brief."
    },
    "absent": [
     "seed"
    ]
   }
  },
  "client_body": {
   "paths": {
    "choices.0.message.content": "hello",
    "choices.0.finish_reason": "stop",
    "usage.prompt_tokens": 7,
    "usage.total_tokens": 10
   }
  }
 }
}
