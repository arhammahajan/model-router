{
  "name": "m5_custom_responses_chat_strict",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-up",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_note",
                "type": "function",
                "function": {
                  "name": "edit_note",
                  "arguments": "{\"content\": \"ligne 1\\n📝 9007199254740993\"}"
                }
              }
            ]
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 7,
        "completion_tokens": 3,
        "total_tokens": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/responses",
    "body": {
      "model": "bridge-resp",
      "input": "Edit the note.",
      "tools": [
        {
          "type": "custom",
          "name": "edit_note",
          "format": {
            "type": "text"
          }
        }
      ],
      "tool_choice": {
        "type": "custom",
        "name": "edit_note"
      }
    }
  },
  "expect": {
    "status": 400,
    "upstream": {
      "exact_requests": 0
    },
    "client_body": {
      "paths": {
        "error.code": "translation_loss"
      }
    }
  }
}
