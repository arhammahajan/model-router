{
  "name": "chat_to_gemini_sse_truncated",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "upstream": {
    "status": 200,
    "sse_frames": [
      "data: {\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"par\"}],\"role\":\"model\"},\"index\":0}]}\n\n"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "bridge-gem",
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "expect": {
    "status": 200,
    "no_done": true,
    "client_text_contains": [
      "\"content\":\"par\""
    ],
    "client_text_absent": [
      "\"finish_reason\":\"stop\"",
      "\"finish_reason\":\"tool_calls\"",
      "\"error\"",
      "[DONE]"
    ],
    "upstream": {
      "path": "/v1beta/models/gemini-2.0-flash:streamGenerateContent",
      "exact_requests": 1
    },
    "sse": {
      "done": false,
      "absent": [
        "[DONE]"
      ]
    }
  }
}
