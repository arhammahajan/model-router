{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"rd-pub\"\nprovider = \"chat\"\nmodel = \"rd-up\"\ndialect = \"openai-chat\"\naliases = [\"rd-alias\"]\n",
  "expect": {
    "client_body": {
      "paths": {
        "choices.0.message.content": "hello"
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "model": "rd-up"
        }
      },
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer prov-chat-secret"
      },
      "path": "/v1/chat/completions"
    }
  },
  "name": "m4_route_dialect_alias_inherits_dest",
  "request": {
    "body": {
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "rd-alias"
    },
    "method": "POST",
    "path": "/v1/chat/completions"
  },
  "upstream": {
    "raw_body": {
      "choices": [
        {
          "finish_reason": "stop",
          "index": 0,
          "message": {
            "content": "hello",
            "role": "assistant"
          }
        }
      ],
      "created": 1,
      "id": "chatcmpl-1",
      "model": "m",
      "object": "chat.completion",
      "usage": {
        "completion_tokens": 1,
        "prompt_tokens": 2,
        "total_tokens": 3
      }
    }
  }
