{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "expect": {
    "client_text_absent": [
      "message_stop",
      "[DONE]"
    ],
    "client_text_contains": [
      "event: error"
    ],
    "status": 200,
    "upstream": {
      "path": "/chat/completions"
    }
  },
  "name": "anthropic_to_chat_midstream_truncation",
  "request": {
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "bridge-chat",
      "stream": true
    },
    "method": "POST",
    "path": "/v1/messages"
  },
  "upstream": {
    "sse_frames": [
      "data: {\"id\":\"c\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"hi\"},\"finish_reason\":null}]}\n\n"
    ],
    "status": 200
  }
}
