{
  "name": "chat_to_gemini_credential_isolation",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "upstream": {
    "raw_body": {
      "candidates": [
        {
          "content": {
            "parts": [
              {
                "text": "hello"
              }
            ],
            "role": "model"
          },
          "finishReason": "STOP",
          "index": 0
        }
      ],
      "usageMetadata": {
        "candidatesTokenCount": 1,
        "promptTokenCount": 2,
        "totalTokenCount": 3
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Goog-Api-Key": "evil-client-key",
      "X-Api-Key": "evil-client-key"
    },
    "body": {
      "model": "bridge-gem",
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ]
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/v1beta/models/gemini-2.0-flash:generateContent",
      "exact_requests": 1,
      "query": "",
      "query_absent": [
        "key"
      ],
      "headers": {
        "x-goog-api-key": "gem-secret",
        "authorization": {
          "absent": true
        },
        "x-api-key": {
          "absent": true
        }
      },
      "body": {
        "paths": {
          "contents.0.parts.0.text": "Hi"
        },
        "absent": [
          "model",
          "stream"
        ]
      }
    },
    "client_body": {
      "paths": {
        "choices.0.message.content": "hello"
      }
    }
  }
}
