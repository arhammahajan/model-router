{
  "name": "anthropic_to_gemini_claude_code_adaptive_lossy",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gemlossy]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\ncompatibility = \"lossy\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gemlossy\"\nmodel = \"gemini-4-argon\"\n",
  "upstream": {
    "raw_body": {
      "candidates": [
        {
          "content": {
            "role": "model",
            "parts": [
              {"text": "pong"}
            ]
          },
          "finishReason": "STOP",
          "index": 0
        }
      ],
      "usageMetadata": {
        "candidatesTokenCount": 1,
        "promptTokenCount": 9,
        "totalTokenCount": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "bridge-gem",
      "max_tokens": 512,
      "stream": false,
      "system": [
        {"type": "text", "text": "You are Claude Code."}
      ],
      "messages": [
        {
          "role": "user",
          "content": "Reply with just the word: ping"
        },
        {
          "role": "system",
          "content": "Environment context"
        }
      ],
      "thinking": {"type": "adaptive"},
      "output_config": {"effort": "medium"},
      "metadata": {"user_id": "user_1"}
    }
  },
  "expect": {
    "status": 200,
    "client_text_contains": [
      "\"text\":\"pong\""
    ],
    "upstream": {
      "path": "/v1beta/models/gemini-4-argon:generateContent",
      "exact_requests": 1,
      "body": {
        "paths": {
          "systemInstruction.parts.0.text": "You are Claude Code.",
          "systemInstruction.parts.1.text": "Environment context",
          "contents.0.role": "user",
          "contents.0.parts.0.text": "Reply with just the word: ping"
        },
        "absent": [
          "generationConfig.thinkingConfig",
          "thinking",
          "metadata",
          "adaptive"
        ]
      }
    }
  }
}
