{
  "_comment": "TDD M4 slice: per-route dialect override. Current Go build rejects explicit different dialect at --validate-config (milestone 4+); HTTP expectations below describe the contracted egress (provider-owned auth, dest-keyed URL/headers/classification). Upstream usage matches the reviewed anthropic_to_responses_text cache case: 12 prompt including 4 cached, 5 output.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"bridge-anth\"\nprovider = \"chat\"\nmodel = \"gpt-4.1\"\ndialect = \"openai-responses\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "content.0.text": "hello",
        "model": "bridge-anth",
        "stop_reason": "end_turn",
        "type": "message",
        "usage.cache_read_input_tokens": 4,
        "usage.input_tokens": 8,
        "usage.output_tokens": 5
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "input.0.content.0.text": "Be brief.",
          "input.0.content.0.type": "input_text",
          "input.0.role": "system",
          "input.1.content.0.text": "Hi",
          "input.1.content.0.type": "input_text",
          "input.1.role": "user",
          "max_output_tokens": 16,
          "model": "gpt-4.1",
          "store": false,
          "temperature": 0.5,
          "top_p": 0.9
        }
      },
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer prov-chat-secret",
        "x-api-key": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/v1/responses",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_route_dialect_anthropic_to_responses",
  "request": {
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "bridge-anth",
      "system": "Be brief.",
      "temperature": 0.5,
      "top_p": 0.9
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1/messages?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "created_at": 1,
      "id": "resp_up",
      "model": "gpt-4.1",
      "object": "response",
      "output": [
        {
          "content": [
            {
              "annotations": [],
              "text": "hello",
              "type": "output_text"
            }
          ],
          "id": "msg_up",
          "role": "assistant",
          "status": "completed",
          "type": "message"
        }
      ],
      "status": "completed",
      "usage": {
        "input_tokens": 12,
        "input_tokens_details": {
          "cached_tokens": 4
        },
        "output_tokens": 5,
        "total_tokens": 17
      }
    }
  }
}
