{
  "_comment": "Responses->Gemini contract. Late unrepresentable upstream content (thought parts, signatures, grounding) is a 502 translation failure, never a success and never silent.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "expect": {
    "client_text_absent": [
      "Traceback",
      "\"status\":\"completed\"",
      "response.completed"
    ],
    "client_text_contains": [
      "error"
    ],
    "status": 502,
    "upstream": {
      "exact_requests": 1,
      "path": "/v1beta/models/gemini-2.0-flash:generateContent"
    }
  },
  "name": "responses_to_gemini_late_unsupported",
  "request": {
    "body": {
      "input": "Hi",
      "model": "bridge-gem"
    },
    "method": "POST",
    "path": "/v1/responses"
  },
  "upstream": {
    "raw_body": {
      "candidates": [
        {
          "content": {
            "parts": [
              {
                "text": "hello",
                "thought": true,
                "thoughtSignature": "sig_abc123"
              }
            ],
            "role": "model"
          },
          "finishReason": "STOP",
          "groundingMetadata": {
            "groundingChunks": [
              {
                "web": {
                  "title": "Example",
                  "uri": "https://example.com"
                }
              }
            ]
          },
          "index": 0,
          "safetyRatings": [
            {
              "blocked": false,
              "category": "HARM_CATEGORY_HARASSMENT",
              "probability": "LOW"
            }
          ]
        }
      ],
      "usageMetadata": {
        "candidatesTokenCount": 3,
        "promptTokenCount": 7,
        "totalTokenCount": 10
      }
    }
  }
}
