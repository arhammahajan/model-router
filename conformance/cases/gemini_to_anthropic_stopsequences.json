{
  "name": "gemini_to_anthropic_stopsequences",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"gem-ant\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n",
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-ant:generateContent",
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ],
      "generationConfig": {
        "candidateCount": 1,
        "maxOutputTokens": 16,
        "stopSequences": [
          "a",
          "b",
          "c",
          "d",
          "e",
          "f"
        ]
      }
    }
  },
  "upstream": {
    "raw_body": {}
  },
  "expect": {
    "status": 400,
    "client_body": {
      "paths": {
        "error.code": 400,
        "error.status": "INVALID_ARGUMENT",
        "error.details.0.reason": "INVALID_REQUEST"
      }
    },
    "upstream": {
      "path": "/v1/messages",
      "exact_requests": 0
    }
  }
}
