{
  "_comment": "TDD M4 anthropic-off: alias resolves to canonical; canonical supported=false strip applies, alias-key override never applies. RED on baseline (400).",
  "name": "m4_reasoning_anthropic_off_alias_canonical_override",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"real\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\naliases = [\"alias-a\"]\n\n[capabilities.overrides.real.reasoning]\nsupported = false\n",
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-1",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 7,
        "completion_tokens": 3,
        "total_tokens": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "alias-a",
      "max_tokens": 16,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "thinking": {
        "type": "disabled"
      }
    }
  },
  "expect": {
    "status": 200,
    "client_headers": {
      "X-Model-Router-Loss": {
        "absent": true
      }
    },
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 1,
      "body": {
        "paths": {
          "model": "gpt-4o-mini"
        },
        "absent": [
          "reasoning_effort",
          "thinking"
        ]
      }
    },
    "client_body": {
      "paths": {
        "content.0.text": "hello",
        "model": "real"
      }
    }
  }
}
