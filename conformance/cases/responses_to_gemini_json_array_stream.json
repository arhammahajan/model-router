{
  "_comment": "Responses->Gemini contract. Client streams Responses SSE while upstream answers with a JSON array (?alt=sse is still requested; framing follows Content-Type, never body sniffing).",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "expect": {
    "client_text_absent": [
      "[DONE]",
      "response.failed"
    ],
    "client_text_contains": [
      "response.completed"
    ],
    "sse": {
      "absent": [
        "[DONE]",
        "response.failed"
      ],
      "counts": {
        "response.completed": 1,
        "response.created": 1
      },
      "integrity": "responses",
      "sequence_numbers": true
    },
    "status": 200,
    "upstream": {
      "body": {
        "absent": [
          "model",
          "stream"
        ],
        "paths": {
          "contents.0.parts.0.text": "Hi"
        }
      },
      "exact_requests": 1,
      "path": "/v1beta/models/gemini-2.0-flash:streamGenerateContent",
      "query": "alt=sse"
    }
  },
  "name": "responses_to_gemini_json_array_stream",
  "request": {
    "body": {
      "input": "Hi",
      "model": "bridge-gem",
      "stream": true
    },
    "method": "POST",
    "path": "/v1/responses"
  },
  "upstream": {
    "headers": {
      "Content-Type": "application/json"
    },
    "raw_body": "[{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"a\"}],\"role\":\"model\"},\"index\":0}]},{\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"b\"}],\"role\":\"model\"},\"finishReason\":\"STOP\",\"index\":0}],\"usageMetadata\":{\"promptTokenCount\":7,\"candidatesTokenCount\":3,\"totalTokenCount\":10}}]"
  }
}
