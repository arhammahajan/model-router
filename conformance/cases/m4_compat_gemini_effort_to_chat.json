{
  "_comment": "F6 compat bridged Chat carries literal reasoning_effort low with loss origin x-model-router-reasoning-effort. RED via --validate-config.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\nbearer_session_compat = true\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\nsession_header = \"x-affinity\"\n\n[[models]]\nname = \"gem-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n\n[capabilities.overrides.\"gem-chat\".reasoning.effort]\nsupported = true\nvalues = [\"low\", \"medium\"]\n",
  "expect": {
    "status": 200,
    "client_headers": {
      "X-Model-Router-Loss": {
        "absent": true
      }
    },
    "client_body": {
      "paths": {
        "candidates.0.content.parts.0.text": "hello",
        "candidates.0.finishReason": "STOP",
        "modelVersion": "gem-chat",
        "responseId": "chatcmpl-up"
      }
    },
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer upstream-secret",
        "x-model-router-reasoning-effort": {
          "absent": true
        }
      },
      "body": {
        "paths": {
          "model": "gpt-4o-mini",
          "reasoning_effort": "low",
          "messages.0.content": "Hi"
        },
        "absent": [
          "contents",
          "generationConfig"
        ]
      }
    }
  },
  "name": "m4_compat_gemini_effort_to_chat",
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-chat:generateContent",
    "headers": {
      "X-Model-Router-Reasoning-Effort": "low"
    },
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ]
    }
  },
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-up",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 7,
        "completion_tokens": 3,
        "total_tokens": 10
      }
    }
