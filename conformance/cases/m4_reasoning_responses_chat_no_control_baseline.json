{
  "_comment": "TDD M4 reverse named-effort slice, honest green baseline control: no reasoning control on the ingress means no reasoning field upstream and no loss report. GREEN on baseline and must stay GREEN after impl (source: plan_reasoning returns empty plan when effort None).",
  "name": "m4_reasoning_responses_chat_no_control_baseline",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-up",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 7,
        "completion_tokens": 3,
        "total_tokens": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/responses",
    "body": {
      "model": "bridge-resp",
      "input": "Hi"
    }
  },
  "expect": {
    "status": 200,
    "client_headers": {
      "X-Model-Router-Loss": {
        "absent": true
      }
    },
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer upstream-secret"
      },
      "body": {
        "absent": [
          "reasoning",
          "reasoning_effort"
        ],
        "paths": {
          "model": "gpt-4o-mini",
          "messages.0.role": "user",
          "messages.0.content": "Hi"
        }
      }
    },
    "client_body": {
      "paths": {
        "status": "completed",
        "output.0.content.0.text": "hello",
        "usage.input_tokens": 7,
        "usage.output_tokens": 3,
        "usage.total_tokens": 10
      }
    }
  }
}
