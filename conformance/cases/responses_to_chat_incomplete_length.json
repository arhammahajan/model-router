{
 "name": "responses_to_chat_incomplete_length",
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
 "upstream": {
  "raw_body": {
   "id": "chatcmpl-up",
   "object": "chat.completion",
   "created": 1,
   "model": "gpt-4o-mini",
   "choices": [
    {
     "index": 0,
     "message": {
      "role": "assistant",
      "content": "partial"
     },
     "finish_reason": "length"
    }
   ],
   "usage": {
    "prompt_tokens": 7,
    "completion_tokens": 3,
    "total_tokens": 10
   }
  }
 },
 "request": {
  "method": "POST",
  "path": "/v1/responses",
  "body": {
   "model": "bridge-resp",
   "input": "Hi"
  }
 },
 "expect": {
  "status": 200,
  "upstream": {
   "path": "/chat/completions",
   "exact_requests": 1
  },
  "client_body": {
   "paths": {
    "status": "incomplete",
    "incomplete_details.reason": "max_output_tokens",
    "output.0.status": "incomplete",
    "output.0.content.0.text": "partial"
   }
  }
 }
}
