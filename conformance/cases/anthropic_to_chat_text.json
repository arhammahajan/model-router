{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "content.0.text": "hello",
        "model": "bridge-chat",
        "stop_reason": "end_turn",
        "type": "message",
        "usage.input_tokens": 7,
        "usage.output_tokens": 3
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "absent": [
          "stream_options"
        ],
        "paths": {
          "model": "gpt-4o-mini"
        }
      },
      "headers": {
        "authorization": "Bearer upstream-secret"
      },
      "path": "/chat/completions"
    }
  },
  "name": "anthropic_to_chat_text",
  "request": {
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "bridge-chat"
    },
    "method": "POST",
    "path": "/v1/messages"
  },
  "upstream": {
    "raw_body": {
      "choices": [
        {
          "finish_reason": "stop",
          "index": 0,
          "message": {
            "content": "hello",
            "role": "assistant"
          }
        }
      ],
      "created": 1,
      "id": "chatcmpl-1",
      "model": "gpt-4o-mini",
      "object": "chat.completion",
      "usage": {
        "completion_tokens": 3,
        "prompt_tokens": 7,
        "total_tokens": 10
      }
    }
  }
}
