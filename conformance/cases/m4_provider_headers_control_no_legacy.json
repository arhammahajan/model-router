{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\nheaders = { \"X-Prov\" = \"prov\" }\n\n[[models]]\nname = \"bridge-ctl\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "choices.0.message.content": "hello"
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "model": "claude-haiku-4-5"
        }
      },
      "exact_requests": 1,
      "headers": {
        "authorization": {
          "absent": true
        },
        "openai-beta": {
          "absent": true
        },
        "x-api-key": "upstream-secret",
        "x-prov": "prov"
      },
      "path": "/v1/messages",
      "query": ""
    }
  },
  "name": "m4_provider_headers_control_no_legacy",
  "request": {
    "body": {
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "bridge-ctl"
    },
    "headers": {
      "Openai-Beta": "assistants=v2"
    },
    "method": "POST",
    "path": "/v1/chat/completions"
  },
  "upstream": {
    "raw_body": {
      "content": [
        {
          "text": "hello",
          "type": "text"
        }
      ],
      "id": "msg_1",
      "model": "m",
      "role": "assistant",
      "stop_reason": "end_turn",
      "type": "message",
      "usage": {
        "input_tokens": 7,
        "output_tokens": 3
      }
    }
  }
}
