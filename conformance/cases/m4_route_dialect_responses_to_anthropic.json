{
  "_comment": "TDD M4 slice: per-route dialect override. Current Go build rejects explicit different dialect at --validate-config (milestone 4+); HTTP expectations below describe the contracted egress (provider-owned auth, dest-keyed URL/headers/classification).",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chat\"\nmodel = \"claude-haiku-4-5\"\ndialect = \"anthropic\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "output.0.content.0.text": "hello",
        "output.0.content.0.type": "output_text",
        "output.0.type": "message",
        "status": "completed",
        "usage.input_tokens": 12,
        "usage.input_tokens_details.cached_tokens": 4,
        "usage.output_tokens": 5,
        "usage.total_tokens": 17
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "absent": [
          "store"
        ],
        "paths": {
          "max_tokens": 16,
          "messages.0.content.0.text": "Hi",
          "messages.0.role": "user",
          "model": "claude-haiku-4-5",
          "system.0.text": "Be brief.",
          "temperature": 0.5,
          "top_p": 0.9
        }
      },
      "exact_requests": 1,
      "headers": {
        "anthropic-version": "2023-06-01",
        "authorization": "Bearer prov-chat-secret",
        "x-api-key": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/v1/messages",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_route_dialect_responses_to_anthropic",
  "request": {
    "body": {
      "input": "Hi",
      "instructions": "Be brief.",
      "max_output_tokens": 16,
      "model": "bridge-resp",
      "temperature": 0.5,
      "top_p": 0.9
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1/responses?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "content": [
        {
          "text": "hello",
          "type": "text"
        }
      ],
      "id": "msg_up",
      "model": "claude-haiku-4-5",
      "role": "assistant",
      "stop_reason": "end_turn",
      "type": "message",
      "usage": {
        "cache_read_input_tokens": 4,
        "input_tokens": 8,
        "output_tokens": 5
      }
    }
  }
}
