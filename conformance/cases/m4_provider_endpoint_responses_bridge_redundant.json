{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.respup]\ndialect = \"openai-responses\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"resp-secret\"\ntimeout = 11\n[providers.respup.litellm_kwargs]\napi_base = \"{UPSTREAM}/v1/responses\"\ntimeout = 11\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"respup\"\nmodel = \"gpt-4.1\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "choices.0.message.content": "hello"
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "model": "gpt-4.1"
        }
      },
      "exact_requests": 1,
      "headers": {
        "anthropic-beta": {
          "absent": true
        },
        "authorization": "Bearer resp-secret",
        "openai-beta": "assistants=v2",
        "x-api-key": {
          "absent": true
        }
      },
      "path": "/v1/responses",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_provider_endpoint_responses_bridge_redundant",
  "request": {
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "bridge-resp"
    },
    "headers": {
      "Anthropic-Beta": "prompt-caching-2024-07-31",
      "Openai-Beta": "assistants=v2"
    },
    "method": "POST",
    "path": "/v1/chat/completions"
  },
  "upstream": {
    "raw_body": {
      "created_at": 1,
      "id": "resp_up",
      "model": "gpt-4.1",
      "object": "response",
      "output": [
        {
          "content": [
            {
              "annotations": [],
              "text": "hello",
              "type": "output_text"
            }
          ],
          "id": "msg_up",
          "role": "assistant",
          "status": "completed",
          "type": "message"
        }
      ],
      "status": "completed",
      "usage": {
        "input_tokens": 7,
        "output_tokens": 3,
        "total_tokens": 10
      }
    }
  }
}
