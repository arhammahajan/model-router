{
 "name": "responses_to_chat_sse_truncated",
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
 "upstream": {
  "status": 200,
  "sse_frames": [
   "data: {\"id\": \"chatcmpl-up\", \"object\": \"chat.completion.chunk\", \"created\": 1, \"model\": \"gpt-4o-mini\", \"choices\": [{\"index\": 0, \"delta\": {\"role\": \"assistant\"}, \"finish_reason\": null}]}\n\n",
   "data: {\"id\": \"chatcmpl-up\", \"object\": \"chat.completion.chunk\", \"created\": 1, \"model\": \"gpt-4o-mini\", \"choices\": [{\"index\": 0, \"delta\": {\"content\": \"par\"}, \"finish_reason\": null}]}\n\n"
  ]
 },
 "request": {
  "method": "POST",
  "path": "/v1/responses",
  "body": {
   "model": "bridge-resp",
   "input": "Hi",
   "stream": true
  }
 },
 "expect": {
  "status": 200,
  "client_text_contains": [
   "\"delta\":\"par\""
  ],
  "client_text_absent": [
   "response.completed",
   "response.output_text.done"
  ],
  "upstream": {
   "path": "/chat/completions",
   "exact_requests": 1
  },
  "sse": {
   "kind": "responses",
   "absent": [
    "response.completed",
    "[DONE]"
   ],
   "counts": {
    "response.failed": 1
   }
  }
 }
}
