{
  "name": "anthropic_to_gemini_early_invalid_stream",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "bridge-gem",
      "max_tokens": 16,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "upstream": {
    "status": 200,
    "sse_frames": [
      "data: {\"mystery\":1}\n\n"
    ]
  },
  "expect": {
    "status": 502,
    "client_body": {
      "paths": {
        "type": "error"
      }
    },
    "client_text_absent": [
      "message_stop",
      "[DONE]"
    ],
    "upstream": {
      "path": "/v1beta/models/gemini-2.0-flash:streamGenerateContent",
      "exact_requests": 1
    }
  }
}
