{
  "name": "m5_custom_chat_anthropic_emulation",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\ncompatibility = \"lossy\"\n\n[[models]]\nname = \"claude-haiku\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n",
  "upstream": {
    "raw_body": {
      "id": "msg_2",
      "type": "message",
      "role": "assistant",
      "model": "m",
      "content": [
        {
          "type": "tool_use",
          "id": "call:note 7",
          "name": "edit_note",
          "input": {
            "content": "ligne 1\n📝 9007199254740993"
          }
        }
      ],
      "stop_reason": "tool_use",
      "usage": {
        "input_tokens": 12,
        "output_tokens": 6
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "claude-haiku",
      "messages": [
        {
          "role": "user",
          "content": "Edit the note."
        }
      ],
      "tools": [
        {
          "type": "custom",
          "custom": {
            "name": "edit_note",
            "format": {
              "type": "grammar",
              "grammar": {
                "syntax": "lark",
                "definition": "start: \"réviser\""
              }
            }
          }
        }
      ],
      "tool_choice": {
        "type": "custom",
        "custom": {
          "name": "edit_note"
        }
      }
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/v1/messages",
      "body": {
        "paths": {
          "tools.0.name": "edit_note",
          "tools.0.description": "\n\nReturn content following this lark grammar:\nstart: \"réviser\"",
          "tools.0.input_schema.properties.content.type": "string",
          "tool_choice.name": "edit_note"
        }
      },
      "exact_requests": 1
    },
    "client_body": {
      "paths": {
        "choices.0.finish_reason": "tool_calls",
        "choices.0.message.tool_calls.0.type": "custom",
        "choices.0.message.tool_calls.0.id": "call:note 7",
        "choices.0.message.tool_calls.0.custom.name": "edit_note",
        "choices.0.message.tool_calls.0.custom.input": "ligne 1\n📝 9007199254740993"
      }
    },
    "client_headers": {
      "X-Model-Router-Loss": {
        "present": true
      }
    }
  }
}
