{
  "name": "chat_to_gemini_developer_lossy",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ncompatibility = \"lossy\"\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "upstream": {
    "raw_body": {
      "candidates": [
        {
          "content": {
            "parts": [
              {
                "text": "hello"
              }
            ],
            "role": "model"
          },
          "finishReason": "STOP",
          "index": 0
        }
      ],
      "modelVersion": "gemini-2.0-flash",
      "responseId": "resp_gem_1",
      "usageMetadata": {
        "candidatesTokenCount": 3,
        "promptTokenCount": 7,
        "totalTokenCount": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "bridge-gem",
      "messages": [
        {
          "role": "developer",
          "content": "Be brief."
        },
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "max_tokens": 16,
      "temperature": 0.5,
      "top_p": 0.9
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/v1beta/models/gemini-2.0-flash:generateContent",
      "exact_requests": 1,
      "headers": {
        "x-goog-api-key": "gem-secret",
        "authorization": {
          "absent": true
        }
      },
      "body": {
        "paths": {
          "contents.0.role": "user",
          "contents.0.parts.0.text": "Hi",
          "systemInstruction.parts.0.text": "Be brief.",
          "generationConfig.maxOutputTokens": 16,
          "generationConfig.temperature": 0.5,
          "generationConfig.topP": 0.9
        },
        "absent": [
          "model",
          "stream"
        ]
      }
    },
    "client_body": {
      "paths": {
        "choices.0.message.content": "hello",
        "choices.0.finish_reason": "stop",
        "usage.prompt_tokens": 7,
        "usage.completion_tokens": 3,
        "usage.total_tokens": 10
      }
    },
    "client_headers": {
      "X-Model-Router-Loss": {
        "present": true
      }
    }
  }
}
