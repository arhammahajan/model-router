{
  "_comment": "TDD M4 slice: per-route dialect override. Current Go build rejects explicit different dialect at --validate-config (milestone 4+); HTTP expectations below describe the contracted egress (provider-owned auth, dest-keyed URL/headers/classification).",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"bridge-chat\"\nprovider = \"chat\"\nmodel = \"gpt-4o-mini\"\ndialect = \"openai-chat\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "content.0.text": "hello",
        "model": "bridge-chat",
        "stop_reason": "end_turn",
        "type": "message",
        "usage.input_tokens": 7,
        "usage.output_tokens": 3
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "absent": [
          "stream_options"
        ],
        "paths": {
          "model": "gpt-4o-mini"
        }
      },
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer prov-chat-secret",
        "x-api-key": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/chat/completions",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_route_dialect_anthropic_to_chat",
  "request": {
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "bridge-chat"
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1/messages?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "choices": [
        {
          "finish_reason": "stop",
          "index": 0,
          "message": {
            "content": "hello",
            "role": "assistant"
          }
        }
      ],
      "created": 1,
      "id": "chatcmpl-up",
      "model": "gpt-4o-mini",
      "object": "chat.completion",
      "usage": {
        "completion_tokens": 3,
        "prompt_tokens": 7,
        "total_tokens": 10
      }
    }
  }
}
