{
  "_comment": "Gemini->Responses contract. Client credentials (?key= and auth headers) never reach upstream; only the configured provider key is sent.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.respup]\ndialect = \"openai-responses\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"resp-secret\"\n\n[[models]]\nname = \"gem-resp\"\nprovider = \"respup\"\nmodel = \"gpt-4.1\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "candidates.0.content.parts.0.text": "hello"
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "model": "gpt-4.1"
        }
      },
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer resp-secret",
        "x-api-key": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/v1/responses",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "gemini_to_responses_credential_isolation",
  "request": {
    "body": {
      "contents": [
        {
          "parts": [
            {
              "text": "Hi"
            }
          ],
          "role": "user"
        }
      ],
      "generationConfig": {
        "candidateCount": 1
      }
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1beta/models/gem-resp:generateContent?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "created_at": 1,
      "id": "resp_up",
      "model": "gpt-4.1",
      "object": "response",
      "output": [
        {
          "content": [
            {
              "annotations": [],
              "text": "hello",
              "type": "output_text"
            }
          ],
          "id": "msg_up",
          "role": "assistant",
          "status": "completed",
          "type": "message"
        }
      ],
      "status": "completed",
      "usage": {
        "input_tokens": 2,
        "output_tokens": 1,
        "total_tokens": 3
      }
    }
  }
}
