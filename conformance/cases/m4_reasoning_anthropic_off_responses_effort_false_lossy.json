{
  "_comment": "TDD M4 anthropic-off: effort.supported=false lossy drops none with header.",
  "name": "m4_reasoning_anthropic_off_responses_effort_false_lossy",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.lossyresp]\ndialect = \"openai-responses\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"resp-secret\"\ncompatibility = \"lossy\"\n\n[[models]]\nname = \"bridge-lossy\"\nprovider = \"lossyresp\"\nmodel = \"gpt-4.1\"\n\n[capabilities.overrides.\"bridge-lossy\".reasoning.effort]\nsupported = false\n",
  "upstream": {
    "raw_body": {
      "id": "resp_up",
      "object": "response",
      "created_at": 1,
      "status": "completed",
      "model": "gpt-4.1",
      "output": [
        {
          "id": "msg_up",
          "type": "message",
          "role": "assistant",
          "status": "completed",
          "content": [
            {
              "type": "output_text",
              "text": "hello",
              "annotations": []
            }
          ]
        }
      ],
      "usage": {
        "input_tokens": 12,
        "output_tokens": 5,
        "total_tokens": 17,
        "input_tokens_details": {
          "cached_tokens": 4
        }
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "bridge-lossy",
      "max_tokens": 16,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "thinking": {
        "type": "disabled"
      }
    }
  },
  "expect": {
    "status": 200,
    "client_headers": {
      "X-Model-Router-Loss": {
        "present": true
      }
    },
    "upstream": {
      "path": "/v1/responses",
      "exact_requests": 1,
      "body": {
        "paths": {
          "model": "gpt-4.1"
        },
        "absent": [
          "reasoning.effort",
          "reasoning",
          "thinking"
        ]
      }
    },
    "client_body": {
      "paths": {
        "content.0.text": "hello"
      }
    }
  }
