{
  "name": "chat_to_gemini_sse_tools",
  "_comment": "Streamed function success Chat<-Gemini: upstream Gemini SSE carries complete functionCall args; the router reassembles them into Chat tool-call fragments (identity chunk plus args). joined_tool_args pins chunking independence.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "upstream": {
    "status": 200,
    "sse_frames": [
      "data: {\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"Working\"}],\"role\":\"model\"},\"index\":0}],\"modelVersion\":\"gemini-2.0-flash\",\"responseId\":\"resp_gem_9\",\"usageMetadata\":{\"promptTokenCount\":12,\"candidatesTokenCount\":1,\"totalTokenCount\":13}}\n\n",
      "data: {\"candidates\":[{\"content\":{\"parts\":[{\"functionCall\":{\"name\":\"get_time\",\"id\":\"fc_gem_9\",\"args\":{\"tz\":\"UTC\",\"n\":9007199254740993}}}],\"role\":\"model\"},\"finishReason\":\"STOP\",\"index\":0}],\"modelVersion\":\"gemini-2.0-flash\",\"responseId\":\"resp_gem_9\",\"usageMetadata\":{\"promptTokenCount\":12,\"candidatesTokenCount\":7,\"totalTokenCount\":19}}\n\n"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "bridge-gem",
      "messages": [
        {
          "role": "user",
          "content": "What time?"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "get_time",
            "description": "clock",
            "parameters": {
              "type": "object",
              "properties": {
                "tz": {
                  "type": "string"
                },
                "n": {
                  "type": "integer"
                }
              }
            },
            "strict": false
          }
        }
      ],
      "stream": true,
      "stream_options": {
        "include_usage": true
      }
    }
  },
  "expect": {
    "status": 200,
    "has_done": true,
    "client_text_contains": [
      "\"content\":\"Working\"",
      "\"name\":\"get_time\"",
      "9007199254740993",
      "\"finish_reason\":\"tool_calls\""
    ],
    "upstream": {
      "path": "/v1beta/models/gemini-2.0-flash:streamGenerateContent",
      "exact_requests": 1,
      "query": "alt=sse"
    },
    "sse": {
      "done": true,
      "integrity": "chat",
      "joined_tool_args": {
        "0": "{\"tz\":\"UTC\",\"n\":9007199254740993}"
      }
    }
  }
}
