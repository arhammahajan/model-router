{
  "name": "anthropic_to_gemini_credential_isolation",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.gem]\ndialect = \"gemini\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"gem-secret\"\n\n[[models]]\nname = \"bridge-gem\"\nprovider = \"gem\"\nmodel = \"gemini-2.0-flash\"\n",
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "headers": {
      "Authorization": "Bearer client-secret",
      "Anthropic-Version": "2020-01-01",
      "Anthropic-Beta": "beta-1",
      "Idempotency-Key": "k-1",
      "Openai-Beta": "assistants=v2",
      "X-Session-Id": "sess-1"
    },
    "body": {
      "model": "bridge-gem",
      "max_tokens": 16,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ]
    }
  },
  "upstream": {
    "raw_body": {
      "candidates": [
        {
          "content": {
            "parts": [
              {
                "text": "hello"
              }
            ],
            "role": "model"
          },
          "finishReason": "STOP",
          "index": 0
        }
      ],
      "modelVersion": "gemini-2.0-flash",
      "responseId": "resp_gem_1",
      "usageMetadata": {
        "promptTokenCount": 7,
        "candidatesTokenCount": 3,
        "totalTokenCount": 10
      }
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/v1beta/models/gemini-2.0-flash:generateContent",
      "exact_requests": 1,
      "headers": {
        "x-goog-api-key": "gem-secret",
        "authorization": {
          "absent": true
        },
        "anthropic-version": {
          "absent": true
        },
        "anthropic-beta": {
          "absent": true
        },
        "idempotency-key": {
          "absent": true
        },
        "x-session-id": {
          "absent": true
        }
      },
      "body": {
        "paths": {
          "contents.0.parts.0.text": "Hi"
        },
        "absent": [
          "model",
          "stream"
        ]
      }
    },
    "client_body": {
      "paths": {
        "content.0.text": "hello",
        "model": "bridge-gem"
      }
    }
  }
}
