{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\nsession_header = \"x-affinity\"\n\n\n[[models]]\nname = \"bridge-sess\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n\n",
  "expect": {
