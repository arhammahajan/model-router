{
  "name": "m5_custom_chat_responses_grammar_history",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.respup]\ndialect = \"openai-responses\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"resp-secret\"\n\n[[models]]\nname = \"bridge-chat\"\nprovider = \"respup\"\nmodel = \"gpt-4.1\"\n",
  "upstream": {
    "raw_body": {
      "id": "resp_up",
      "object": "response",
      "created_at": 1,
      "status": "completed",
      "model": "gpt-4.1",
      "output": [
        {
          "type": "custom_tool_call",
          "id": "ctc_returned",
          "call_id": "call:opaque 1",
          "name": "edit_note",
          "input": "réviser 📝\n9007199254740993",
          "status": "completed"
        }
      ],
      "usage": {
        "input_tokens": 7,
        "output_tokens": 3,
        "total_tokens": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "bridge-chat",
      "messages": [
        {
          "role": "user",
          "content": "Revise the note."
        },
        {
          "role": "assistant",
          "tool_calls": [
            {
              "id": "previous:call 9",
              "type": "custom",
              "custom": {
                "name": "edit_note",
                "input": "réviser 📝\n9007199254740993"
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "previous:call 9",
          "content": "done"
        }
      ],
      "tools": [
        {
          "type": "custom",
          "custom": {
            "name": "edit_note",
            "format": {
              "type": "grammar",
              "grammar": {
                "syntax": "lark",
                "definition": "start: \"réviser\""
              }
            }
          }
        }
      ],
      "tool_choice": {
        "type": "custom",
        "custom": {
          "name": "edit_note"
        }
      }
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/v1/responses",
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer resp-secret"
      },
      "body": {
        "paths": {
          "tools.0.type": "custom",
          "tools.0.name": "edit_note",
          "tool_choice.type": "custom",
          "tool_choice.name": "edit_note",
          "input.1.type": "custom_tool_call",
          "input.1.call_id": "previous:call 9",
          "input.1.input": "réviser 📝\n9007199254740993",
          "input.2.type": "custom_tool_call_output",
          "input.2.call_id": "previous:call 9",
          "input.2.output": "done",
          "tools.0.format.syntax": "lark",
          "tools.0.format.definition": "start: \"réviser\""
        }
      }
    },
    "client_body": {
      "paths": {
        "model": "bridge-chat",
        "choices.0.finish_reason": "tool_calls",
        "choices.0.message.tool_calls.0.type": "custom",
        "choices.0.message.tool_calls.0.id": "call:opaque 1",
        "choices.0.message.tool_calls.0.custom.name": "edit_note",
        "choices.0.message.tool_calls.0.custom.input": "réviser 📝\n9007199254740993"
      }
    },
    "client_headers": {
      "X-Model-Router-Loss": {
        "absent": true
      }
    }
  }
}
