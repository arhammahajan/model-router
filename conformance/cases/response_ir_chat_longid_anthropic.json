{
  "name": "response_ir_chat_longid_anthropic",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "bridge-chat",
      "max_tokens": 64,
      "messages": [
        {
          "role": "user",
          "content": "What time?"
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "checking"
            },
            {
              "type": "tool_use",
              "id": "call_1",
              "name": "get_time",
              "input": {
                "tz": "UTC",
                "n": 9007199254740993
              }
            }
          ]
        },
        {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "call_1",
              "content": "noon"
            }
          ]
        }
      ],
      "tools": [
        {
          "name": "get_time",
          "input_schema": {
            "type": "object"
          }
        }
      ],
      "tool_choice": {
        "type": "tool",
        "name": "get_time"
      }
    }
  },
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "object": "chat.completion",
      "created": 1700000000,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello long",
            "tool_calls": [
              {
                "id": "call_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "type": "function",
                "function": {
                  "name": "get_time",
                  "arguments": "{\"tz\":\"UTC\",\"n\":9007199254740993}"
                }
              }
            ]
          },
          "finish_reason": "tool_calls"
        }
      ],
      "usage": {
        "prompt_tokens": 7,
        "completion_tokens": 3,
        "total_tokens": 10
