    "client_body": {
      "paths": {
        "model": "bridge-chat",
        "type": "message",
        "stop_reason": "tool_use",
        "content.0.text": "hello long",
        "content.1.type": "tool_use",
        "content.1.id": "call_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "content.1.name": "get_time",
