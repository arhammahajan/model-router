{
  "name": "gemini_to_chat_credential_isolation",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"gem-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-up",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": "hello"
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 2,
        "completion_tokens": 1,
        "total_tokens": 3
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-chat:generateContent?key=evil-client-key",
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Goog-Api-Key": "evil-client-key",
      "X-Api-Key": "evil-client-key"
    },
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ],
      "generationConfig": {
        "candidateCount": 1
      }
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 1,
      "query": "",
      "query_absent": [
        "key"
      ],
      "headers": {
        "authorization": "Bearer upstream-secret",
        "x-goog-api-key": {
          "absent": true
        },
        "x-api-key": {
          "absent": true
        }
      },
      "body": {
        "paths": {
          "model": "gpt-4o-mini"
        }
      }
    },
    "client_body": {
      "paths": {
        "candidates.0.content.parts.0.text": "hello"
      }
    }
  }
}
