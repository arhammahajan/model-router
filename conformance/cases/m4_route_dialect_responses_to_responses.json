{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"pub-resp\"\nprovider = \"chat\"\nmodel = \"up-resp\"\ndialect = \"openai-responses\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "status": "completed"
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "model": "up-resp"
        }
      },
      "headers": {
        "authorization": "Bearer prov-chat-secret"
      },
      "path": "/v1/responses"
    }
  },
  "name": "m4_route_dialect_responses_to_responses",
  "request": {
    "body": {
      "input": "Hi",
      "model": "pub-resp",
      "mystery_field": {
        "nested": [
          9007199254740993
        ]
      }
    },
    "method": "POST",
    "path": "/v1/responses"
  },
  "upstream": {
    "raw_body": {
      "created_at": 1,
      "id": "resp_1",
      "model": "resp-model",
      "object": "response",
      "output": [
        {
          "content": [
            {
              "text": "ok",
              "type": "output_text"
            }
          ],
          "role": "assistant",
          "type": "message"
        }
      ],
      "status": "completed"
    }
  }
}
