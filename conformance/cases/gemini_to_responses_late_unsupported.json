{
  "_comment": "Gemini->Responses contract. Late unrepresentable upstream content (reasoning item) is a 502 translation failure, never an ordinary STOP and never a success.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.respup]\ndialect = \"openai-responses\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"resp-secret\"\n\n[[models]]\nname = \"gem-resp\"\nprovider = \"respup\"\nmodel = \"gpt-4.1\"\n",
  "expect": {
    "client_text_absent": [
      "\"finishReason\":\"STOP\"",
      "\"text\":\"hello\"",
      "Traceback"
    ],
    "client_text_contains": [
      "\"error\""
    ],
    "status": 502,
    "upstream": {
      "exact_requests": 1,
      "path": "/v1/responses"
    }
  },
  "name": "gemini_to_responses_late_unsupported",
  "request": {
    "body": {
      "contents": [
        {
          "parts": [
            {
              "text": "Hi"
            }
          ],
          "role": "user"
        }
      ],
      "generationConfig": {
        "candidateCount": 1
      }
    },
    "method": "POST",
    "path": "/v1beta/models/gem-resp:generateContent"
  },
  "upstream": {
    "raw_body": {
      "created_at": 1,
      "id": "resp_up",
      "model": "gpt-4.1",
      "object": "response",
      "output": [
        {
          "id": "rs_1",
          "status": "completed",
          "type": "reasoning"
        }
      ],
      "status": "completed",
      "usage": {
        "input_tokens": 7,
        "output_tokens": 3,
        "total_tokens": 10
      }
    }
  }
}
