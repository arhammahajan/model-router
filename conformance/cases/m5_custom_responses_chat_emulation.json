{
  "name": "m5_custom_responses_chat_emulation",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\ncompatibility = \"lossy\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "upstream": {
    "raw_body": {
      "id": "chatcmpl-up",
      "object": "chat.completion",
      "created": 1,
      "model": "gpt-4o-mini",
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_note",
                "type": "function",
                "function": {
                  "name": "edit_note",
                  "arguments": "{\"content\": \"ligne 1\\n📝 9007199254740993\"}"
                }
              }
            ]
          },
          "finish_reason": "stop"
        }
      ],
      "usage": {
        "prompt_tokens": 7,
        "completion_tokens": 3,
        "total_tokens": 10
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/responses",
    "body": {
      "model": "bridge-resp",
      "input": "Edit the note.",
      "tools": [
        {
          "type": "custom",
          "name": "edit_note",
          "format": {
            "type": "text"
          }
        }
      ],
      "tool_choice": {
        "type": "custom",
        "name": "edit_note"
      }
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer upstream-secret"
      },
      "body": {
        "paths": {
          "tools.0.function.name": "edit_note",
          "tools.0.function.parameters.properties.content.type": "string",
          "tools.0.function.parameters.additionalProperties": false,
          "tool_choice.function.name": "edit_note"
        }
      }
    },
    "client_body": {
      "paths": {
        "status": "completed",
        "output.0.type": "custom_tool_call",
        "output.0.call_id": "call_note",
        "output.0.name": "edit_note",
        "output.0.input": "ligne 1\n📝 9007199254740993",
        "tool_choice.type": "custom",
        "tool_choice.name": "edit_note",
        "tools.0.type": "custom",
        "tools.0.name": "edit_note"
      }
    },
    "client_headers": {
      "X-Model-Router-Loss": {
        "present": true
      }
    }
  }
}
