{
  "name": "gemini_to_chat_strict_loss",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"gem-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "upstream": {
    "raw_body": {}
  },
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-chat:generateContent",
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ],
      "safetySettings": [
        {
          "category": "HARM_CATEGORY_HARASSMENT",
          "threshold": "BLOCK_NONE"
        }
      ],
      "generationConfig": {
        "candidateCount": 1,
        "topK": 5,
        "thinkingConfig": {
          "thinkingBudget": 10
        }
      }
    }
  },
  "expect": {
    "status": 400,
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 0
    },
    "client_body": {
      "paths": {
        "error.code": 400,
        "error.status": "INVALID_ARGUMENT",
        "error.details.0.reason": "TRANSLATION_LOSS"
      }
    }
  }
}
