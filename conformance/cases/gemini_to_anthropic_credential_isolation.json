{
  "name": "gemini_to_anthropic_credential_isolation",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"gem-ant\"\nprovider = \"anth\"\nmodel = \"claude-haiku-4-5\"\n",
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-ant:generateContent?key=evil-client-key",
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Goog-Api-Key": "evil-client-key",
      "X-Api-Key": "evil-client-key"
    },
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ],
      "generationConfig": {
        "candidateCount": 1,
        "maxOutputTokens": 16
      }
    }
  },
  "upstream": {
    "raw_body": {
      "id": "msg_up",
      "type": "message",
      "role": "assistant",
      "model": "claude-haiku-4-5",
      "content": [
        {
          "type": "text",
          "text": "hello"
        }
      ],
      "stop_reason": "end_turn",
      "usage": {
        "input_tokens": 7,
        "output_tokens": 3
      }
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "path": "/v1/messages",
      "exact_requests": 1,
      "query": "",
      "query_absent": [
        "key",
        "alt"
      ],
      "headers": {
        "x-api-key": "upstream-secret",
        "authorization": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "body": {
        "paths": {
          "model": "claude-haiku-4-5"
        }
      }
    },
    "client_body": {
      "paths": {
        "candidates.0.content.parts.0.text": "hello"
      }
    }
  }
}
