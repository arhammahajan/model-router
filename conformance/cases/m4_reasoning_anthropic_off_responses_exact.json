{
  "_comment": "TDD M4 anthropic-off slice (Responses ONLY): thinking disabled maps exactly to reasoning.effort none with no loss. RED on baseline (loss 400).",
  "name": "m4_reasoning_anthropic_off_responses_exact",
  "config": " [server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.respup]\ndialect = \"openai-responses\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"resp-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"respup\"\nmodel = \"o1-mini\"\n",
  "upstream": {
    "raw_body": {
      "id": "resp_up",
      "object": "response",
      "created_at": 1,
      "status": "completed",
      "model": "o1-mini",
      "output": [
        {
          "id": "msg_up",
          "type": "message",
          "role": "assistant",
          "status": "completed",
          "content": [
            {
              "type": "output_text",
              "text": "hello",
              "annotations": []
            }
          ]
        }
      ],
      "usage": {
        "input_tokens": 12,
        "output_tokens": 5,
        "total_tokens": 17,
        "input_tokens_details": {
          "cached_tokens": 4
        }
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "bridge-resp",
      "max_tokens": 16,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "thinking": {
        "type": "disabled"
      }
    }
  },
  "expect": {
    "status": 200,
    "client_headers": {
      "X-Model-Router-Loss": {
        "absent": true
      }
    },
    "upstream": {
      "path": "/v1/responses",
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer resp-secret"
      },
      "body": {
        "paths": {
          "model": "o1-mini",
          "reasoning.effort": "none",
          "input.0.role": "user",
          "input.0.content.0.type": "input_text",
          "input.0.content.0.text": "Hi"
        },
        "absent": [
          "thinking"
        ]
      }
    },
    "client_body": {
      "paths": {
        "content.0.text": "hello",
        "model": "bridge-resp",
        "stop_reason": "end_turn",
        "type": "message",
        "usage.input_tokens": 8,
        "usage.output_tokens": 5,
        "usage.cache_read_input_tokens": 4
      }
    }
  }
}
