{
 "name": "chat_to_responses_late_unsupported",
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.respup]\ndialect = \"openai-responses\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"resp-secret\"\n\n[[models]]\nname = \"bridge-chat\"\nprovider = \"respup\"\nmodel = \"gpt-4.1\"\n",
 "upstream": {
  "raw_body": {
   "id": "resp_up",
   "object": "response",
   "created_at": 1,
   "status": "completed",
   "model": "gpt-4.1",
   "output": [
    {
     "id": "rs_1",
     "type": "reasoning",
     "status": "completed"
    }
   ],
   "usage": {
    "input_tokens": 7,
    "output_tokens": 3,
    "total_tokens": 10
   }
  }
 },
 "request": {
  "method": "POST",
  "path": "/v1/chat/completions",
  "body": {
   "model": "bridge-chat",
   "messages": [
    {
     "role": "user",
     "content": "Hi"
    }
   ]
  }
 },
 "expect": {
  "status": 502,
  "client_text_contains": [
   "\"error\""
  ],
  "client_text_absent": [
   "\"finish_reason\":\"stop\"",
   "\"content\":\"hello\"",
   "Traceback"
  ],
  "upstream": {
   "path": "/v1/responses",
   "exact_requests": 1
  }
 }
}
