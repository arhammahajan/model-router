{
 "name": "responses_to_chat_tools",
 "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
 "upstream": {
  "raw_body": {
   "id": "chatcmpl-up",
   "object": "chat.completion",
   "created": 1,
   "model": "gpt-4o-mini",
   "choices": [
    {
     "index": 0,
     "message": {
      "role": "assistant",
      "content": null,
      "tool_calls": [
       {
        "id": "call_up",
        "type": "function",
        "function": {
         "name": "get_time",
         "arguments": "{\"tz\":\"UTC\",\"n\":9007199254740993}"
        }
       }
      ]
     },
     "finish_reason": "stop"
    }
   ],
   "usage": {
    "prompt_tokens": 7,
    "completion_tokens": 3,
    "total_tokens": 10
   }
  }
 },
 "request": {
  "method": "POST",
  "path": "/v1/responses",
  "body": {
   "model": "bridge-resp",
   "input": [
    {
     "role": "user",
     "content": "What time?"
    },
    {
     "type": "function_call",
     "id": "fc_1",
     "call_id": "call_1",
     "name": "get_time",
     "arguments": "{\"tz\":\"UTC\",\"n\":9007199254740993}"
    },
    {
     "type": "function_call_output",
     "call_id": "call_1",
     "output": "noon"
    }
   ],
   "tools": [
    {
     "type": "function",
     "name": "get_time",
     "description": "clock",
     "parameters": {
      "type": "object",
      "properties": {
       "tz": {
        "type": "string"
       }
      }
     },
     "strict": false
    }
   ],
   "tool_choice": {
    "type": "function",
    "name": "get_time"
   }
  }
 },
 "expect": {
  "status": 200,
  "upstream": {
   "path": "/chat/completions",
   "exact_requests": 1,
   "headers": {
    "authorization": "Bearer upstream-secret"
   },
   "body": {
    "paths": {
     "tools.0.type": "function",
     "tools.0.function.name": "get_time",
     "tool_choice.type": "function",
     "tool_choice.function.name": "get_time",
     "messages.1.tool_calls.0.id": "call_1",
     "messages.1.tool_calls.0.function.name": "get_time",
     "messages.2.tool_call_id": "call_1",
     "messages.2.content": "noon",
     "messages.1.tool_calls.0.function.arguments": {
      "__contains__": "9007199254740993"
     }
    }
   }
  },
  "client_body": {
   "paths": {
    "status": "completed",
    "output.0.type": "function_call",
    "output.0.call_id": "call_up",
    "output.0.name": "get_time",
    "output.0.arguments": {
     "__contains__": "9007199254740993"
    },
    "tools.0.type": "function",
    "tools.0.name": "get_time",
    "tool_choice.type": "function",
    "tool_choice.name": "get_time"
   }
  }
 }
}
