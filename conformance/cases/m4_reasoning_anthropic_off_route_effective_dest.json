{
  "_comment": "TDD M4 anthropic-off: per-route dialect override selects the effective dest (chat provider serving Responses); raw metadata.router injection is ignored, disabled still maps to reasoning.effort none. RED on baseline.",
  "name": "m4_reasoning_anthropic_off_route_effective_dest",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"rd-resp\"\nprovider = \"chatup\"\nmodel = \"o1-mini\"\ndialect = \"openai-responses\"\n\n[models.metadata.router.reasoning]\nsupported = false\n",
  "upstream": {
    "raw_body": {
      "id": "resp_up",
      "object": "response",
      "created_at": 1,
      "status": "completed",
      "model": "o1-mini",
      "output": [
        {
          "id": "msg_up",
          "type": "message",
          "role": "assistant",
          "status": "completed",
          "content": [
            {
              "type": "output_text",
              "text": "hello",
              "annotations": []
            }
          ]
        }
      ],
      "usage": {
        "input_tokens": 12,
        "output_tokens": 5,
        "total_tokens": 17,
        "input_tokens_details": {
          "cached_tokens": 4
        }
      }
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "body": {
      "model": "rd-resp",
      "max_tokens": 16,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "thinking": {
        "type": "disabled"
      }
    }
  },
  "expect": {
    "status": 200,
    "client_headers": {
      "X-Model-Router-Loss": {
        "absent": true
      }
    },
    "upstream": {
      "path": "/v1/responses",
      "exact_requests": 1,
      "body": {
        "paths": {
          "model": "o1-mini",
          "reasoning.effort": "none"
        },
        "absent": [
          "thinking"
        ]
      }
    },
    "client_body": {
      "paths": {
        "content.0.text": "hello",
        "model": "rd-resp"
      }
    }
  }
}
