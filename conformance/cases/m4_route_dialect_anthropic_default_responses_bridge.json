{
  "_comment": "TDD M4 slice: per-route dialect override. Current Go build rejects explicit different dialect at --validate-config (milestone 4+); HTTP expectations below describe the contracted egress (provider-owned auth, dest-keyed URL/headers/classification). anthropic-version default is dest-keyed, so absent on a responses dest.",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.anth]\ndialect = \"anthropic\"\nbase_url = \"{UPSTREAM}/v1\"\napi_key = \"anth-secret\"\n\n[[models]]\nname = \"rd-resp\"\nprovider = \"anth\"\nmodel = \"gpt-4.1\"\ndialect = \"openai-responses\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "choices.0.message.content": "hello"
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "model": "gpt-4.1"
        }
      },
      "exact_requests": 1,
      "headers": {
        "anthropic-version": {
          "absent": true
        },
        "authorization": {
          "absent": true
        },
        "x-api-key": "anth-secret",
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/v1/responses",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_route_dialect_anthropic_default_responses_bridge",
  "request": {
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "rd-resp"
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1/chat/completions?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "created_at": 1,
      "id": "resp_up",
      "model": "gpt-4.1",
      "object": "response",
      "output": [
        {
          "content": [
            {
              "annotations": [],
              "text": "hello",
              "type": "output_text"
            }
          ],
          "id": "msg_up",
          "role": "assistant",
          "status": "completed",
          "type": "message"
        }
      ],
      "status": "completed",
      "usage": {
        "input_tokens": 12,
        "input_tokens_details": {
          "cached_tokens": 4
        },
        "output_tokens": 5,
        "total_tokens": 17
      }
    }
  }
}
