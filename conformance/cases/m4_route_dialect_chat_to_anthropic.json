{
  "_comment": "TDD M4 slice: per-route dialect override. Current Go build rejects explicit different dialect at --validate-config (milestone 4+); HTTP expectations below describe the contracted egress (provider-owned auth, dest-keyed URL/headers/classification).",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"claude-haiku\"\nprovider = \"chat\"\nmodel = \"claude-haiku-4-5\"\ndialect = \"anthropic\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "choices.0.finish_reason": "stop",
        "choices.0.message.content": "hello",
        "usage.prompt_tokens": 7,
        "usage.total_tokens": 10
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "absent": [
          "seed"
        ],
        "paths": {
          "max_tokens": 16,
          "messages.0.role": "user",
          "model": "claude-haiku-4-5",
          "system.0.text": "Be brief."
        }
      },
      "headers": {
        "anthropic-version": "2023-06-01",
        "authorization": "Bearer prov-chat-secret",
        "x-api-key": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/v1/messages",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_route_dialect_chat_to_anthropic",
  "request": {
    "body": {
      "max_tokens": 16,
      "messages": [
        {
          "content": "Be brief.",
          "role": "system"
        },
        {
          "content": "Hi",
          "role": "user"
        }
      ],
      "model": "claude-haiku"
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1/chat/completions?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "content": [
        {
          "text": "hello",
          "type": "text"
        }
      ],
      "id": "msg_1",
      "model": "m",
      "role": "assistant",
      "stop_reason": "end_turn",
      "type": "message",
      "usage": {
        "input_tokens": 7,
        "output_tokens": 3
      }
    }
  }
}
