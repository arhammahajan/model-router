{
  "name": "gemini_to_chat_json_array_stream",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[[models]]\nname = \"gem-chat\"\nprovider = \"chatup\"\nmodel = \"gpt-4o-mini\"\n",
  "upstream": {
    "status": 200,
    "sse_frames": [
      "data: {\"id\":\"chatcmpl-up\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":\"gpt-4o-mini\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"a\"},\"finish_reason\":null}]}\n\n",
      "data: {\"id\":\"chatcmpl-up\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":\"gpt-4o-mini\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"b\"},\"finish_reason\":null}]}\n\n",
      "data: {\"id\":\"chatcmpl-up\",\"object\":\"chat.completion.chunk\",\"created\":1,\"model\":\"gpt-4o-mini\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":3,\"total_tokens\":10}}\n\n",
      "data: [DONE]\n\n"
    ]
  },
  "request": {
    "method": "POST",
    "path": "/v1beta/models/gem-chat:streamGenerateContent",
    "body": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Hi"
            }
          ]
        }
      ],
      "generationConfig": {
        "candidateCount": 1
      }
    }
  },
  "expect": {
    "status": 200,
    "client_headers": {
      "Content-Type": "application/json"
    },
    "client_text_contains": [
      "\"text\":\"a\"",
      "\"text\":\"b\"",
      "\"finishReason\":\"STOP\""
    ],
    "client_text_absent": [
      "[DONE]",
      "Traceback"
    ],
    "gemini_array": {
      "present": true,
      "joined_text": "ab"
    },
    "upstream": {
      "path": "/chat/completions",
      "exact_requests": 1,
      "query": "",
      "body": {
        "paths": {
          "stream": true,
          "model": "gpt-4o-mini"
        }
      }
    }
  }
}
