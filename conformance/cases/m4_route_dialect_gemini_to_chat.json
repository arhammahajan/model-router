{
  "_comment": "TDD M4 slice: per-route dialect override. Current Go build rejects explicit different dialect at --validate-config (milestone 4+); HTTP expectations below describe the contracted egress (provider-owned auth, dest-keyed URL/headers/classification).",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"gem-chat\"\nprovider = \"chat\"\nmodel = \"gpt-4o-mini\"\ndialect = \"openai-chat\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "candidates.0.content.parts.0.text": "hello",
        "candidates.0.finishReason": "STOP",
        "modelVersion": "gem-chat",
        "responseId": "chatcmpl-up",
        "usageMetadata.cachedContentTokenCount": 2,
        "usageMetadata.candidatesTokenCount": 2,
        "usageMetadata.promptTokenCount": 7,
        "usageMetadata.thoughtsTokenCount": 1,
        "usageMetadata.totalTokenCount": 10
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "absent": [
          "contents",
          "systemInstruction",
          "generationConfig"
        ],
        "paths": {
          "max_tokens": 16,
          "messages.0.content": "Be brief.",
          "messages.1.content": "Hi",
          "model": "gpt-4o-mini",
          "temperature": 0.5,
          "top_p": 0.9
        }
      },
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer prov-chat-secret",
        "x-api-key": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/chat/completions",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_route_dialect_gemini_to_chat",
  "request": {
    "body": {
      "contents": [
        {
          "parts": [
            {
              "text": "Hi"
            }
          ],
          "role": "user"
        }
      ],
      "generationConfig": {
        "candidateCount": 1,
        "maxOutputTokens": 16,
        "temperature": 0.5,
        "topP": 0.9
      },
      "systemInstruction": {
        "parts": [
          {
            "text": "Be brief."
          }
        ]
      }
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1beta/models/gem-chat:generateContent?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "choices": [
        {
          "finish_reason": "stop",
          "index": 0,
          "message": {
            "content": "hello",
            "role": "assistant"
          }
        }
      ],
      "created": 1,
      "id": "chatcmpl-up",
      "model": "gpt-4o-mini",
      "object": "chat.completion",
      "usage": {
        "completion_tokens": 3,
        "completion_tokens_details": {
          "reasoning_tokens": 1
        },
        "prompt_tokens": 7,
        "prompt_tokens_details": {
          "cached_tokens": 2
        },
        "total_tokens": 10
      }
    }
  }
}
