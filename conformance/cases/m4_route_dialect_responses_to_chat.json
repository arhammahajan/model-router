{
  "_comment": "TDD M4 slice: per-route dialect override. Current Go build rejects explicit different dialect at --validate-config (milestone 4+); HTTP expectations below describe the contracted egress (provider-owned auth, dest-keyed URL/headers/classification).",
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chat]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"prov-chat-secret\"\n\n[[models]]\nname = \"bridge-resp\"\nprovider = \"chat\"\nmodel = \"gpt-4o-mini\"\ndialect = \"openai-chat\"\n",
  "expect": {
    "client_body": {
      "paths": {
        "output.0.content.0.text": "hello",
        "output.0.content.0.type": "output_text",
        "output.0.status": "completed",
        "output.0.type": "message",
        "status": "completed",
        "usage.input_tokens": 7,
        "usage.output_tokens": 3,
        "usage.total_tokens": 10
      }
    },
    "status": 200,
    "upstream": {
      "body": {
        "paths": {
          "max_tokens": 16,
          "messages.0.content": "Be brief.",
          "messages.0.role": "system",
          "messages.1.content": "Hi",
          "messages.1.role": "user",
          "model": "gpt-4o-mini",
          "temperature": 0.5,
          "top_p": 0.9
        }
      },
      "exact_requests": 1,
      "headers": {
        "authorization": "Bearer prov-chat-secret",
        "x-api-key": {
          "absent": true
        },
        "x-goog-api-key": {
          "absent": true
        }
      },
      "path": "/chat/completions",
      "query": "",
      "query_absent": [
        "key"
      ]
    }
  },
  "name": "m4_route_dialect_responses_to_chat",
  "request": {
    "body": {
      "input": "Hi",
      "instructions": "Be brief.",
      "max_output_tokens": 16,
      "model": "bridge-resp",
      "temperature": 0.5,
      "top_p": 0.9
    },
    "headers": {
      "Authorization": "Bearer evil-client-key",
      "X-Api-Key": "evil-client-key",
      "X-Goog-Api-Key": "evil-client-key"
    },
    "method": "POST",
    "path": "/v1/responses?key=evil-client-key"
  },
  "upstream": {
    "raw_body": {
      "choices": [
        {
          "finish_reason": "stop",
          "index": 0,
          "message": {
            "content": "hello",
            "role": "assistant"
          }
        }
      ],
      "created": 1,
      "id": "chatcmpl-up",
      "model": "gpt-4o-mini",
      "object": "chat.completion",
      "usage": {
        "completion_tokens": 3,
        "prompt_tokens": 7,
        "total_tokens": 10
      }
    }
  }
}
