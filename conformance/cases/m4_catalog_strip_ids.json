{
  "config": "[server]\nauth_mode = \"none\"\nallow_dynamic_routes = false\n\n[retry]\nmax_attempts = 1\n\n[providers.chatup]\ndialect = \"openai-chat\"\nbase_url = \"{UPSTREAM}\"\napi_key = \"upstream-secret\"\n\n[catalog]\nurl = \"{UPSTREAM}/catalog\"\ntimeout = 5\nrefresh_seconds = 0\nheaders = { \"X-Catalog-Token\" = \"cat-secret\" }\n\n[catalog.model_providers]\n\"test-trim\" = \"chatup\"\n\n",
  "upstream": {
    "sequence": [
      {
        "raw_body": {
          "data": [
            {
              "id": "\u001c  test-trim \u001f",
              "metadata": {}
            }
          ]
        }
      },
      {
        "raw_body": {
          "id": "chatcmpl-1",
          "object": "chat.completion",
          "created": 1,
          "model": "m",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "hello"
              },
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 2,
            "completion_tokens": 1,
            "total_tokens": 3
          }
        }
      }
    ]
  },
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "body": {
      "model": "test-trim",
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ]
    }
  },
  "expect": {
    "status": 200,
    "upstream": {
      "exact_requests": 2,
      "path": "/chat/completions",
      "headers": {
        "authorization": "Bearer upstream-secret"
      },
      "body": {
        "paths": {
          "model": "test-trim"
        }
      }
    },
    "client_body": {
      "paths": {
        "choices.0.message.content": "hello"
      }
    }
  },
  "name": "m4_catalog_strip_ids"
}
